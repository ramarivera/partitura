[Unit]
Description=Partitura per-session Sysbox sandbox broker request
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
TimeoutStartSec=infinity
TimeoutStopSec=5s
User=root
Group=root
EnvironmentFile=/etc/partitura-sandbox/broker.env
ExecStart=/usr/bin/python3 /opt/partitura-sandbox/broker.py
StandardInput=socket
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/partitura-sandbox
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
MemoryDenyWriteExecute=true
UMask=0077
