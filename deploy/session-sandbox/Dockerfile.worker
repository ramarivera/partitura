# Build this image once, then configure the broker with its sha256 digest.
# The session container is isolated by Sysbox; its Docker daemon never shares
# the host Docker socket.
ARG DOCKER_VERSION=29.9.1
FROM docker:${DOCKER_VERSION}-dind AS docker

FROM node:26.8.1-bookworm-slim AS node

FROM oven/bun:1.3.14 AS mise-tools
ARG TARGETARCH
RUN apt-get update \
  && apt-get install -y --no-install-recommends bash ca-certificates curl \
  && rm -rf /var/lib/apt/lists/*
COPY deploy/build-tools/fetch-mise.sh /usr/local/bin/fetch-mise
RUN chmod 0755 /usr/local/bin/fetch-mise \
  && case "${TARGETARCH}" in \
       amd64) platform=linux-x64 ;; \
       arm64) platform=linux-arm64 ;; \
       *) echo "Unsupported architecture: ${TARGETARCH}" >&2; exit 1 ;; \
     esac \
  && install -d /usr/local/bin \
  && fetch-mise "${platform}" /usr/local/bin/mise
COPY deploy/build-tools/mise.toml /opt/partitura/build-tools/mise.toml
ENV MISE_DATA_DIR=/opt/partitura/mise
ENV MISE_TRUSTED_CONFIG_PATHS=/opt/partitura/build-tools
ENV MISE_YES=1
WORKDIR /opt/partitura/build-tools
RUN /usr/local/bin/mise install \
  && install -d /opt/partitura/bin \
  && node_bin="$(/usr/local/bin/mise which node)" \
  && node_root="${node_bin%/bin/node}" \
  && ln -s "$node_bin" /opt/partitura/bin/node \
  && ln -s "$node_root/lib/node_modules/npm/bin/npm-cli.js" /opt/partitura/bin/npm \
  && ln -s "$node_root/lib/node_modules/npm/bin/npx-cli.js" /opt/partitura/bin/npx \
  && ln -s "$(/usr/local/bin/mise which python)" /opt/partitura/bin/python \
  && ln -s "$(/usr/local/bin/mise which python3)" /opt/partitura/bin/python3 \
  && chmod -R go-w /opt/partitura

FROM oven/bun:1.3.14 AS worker-extensions
WORKDIR /opt/omp-extensions
COPY deploy/worker-extensions/package.json deploy/worker-extensions/bun.lock ./
RUN bun install --frozen-lockfile --production --omit=optional --ignore-scripts

FROM oven/bun:1.3.14 AS app-build
WORKDIR /app
COPY package.json bun.lock* ./
RUN bun install --frozen-lockfile
COPY tsconfig.json biome.json ./
COPY src ./src
COPY deploy/mac-build/builder-secret.ts deploy/mac-build/native-build-budget-admin.ts deploy/mac-build/native-build-admin.ts deploy/mac-build/native-build-operator-launch.ts deploy/mac-build/native-build-import.ts deploy/mac-build/native-build-import-config.ts deploy/mac-build/native-build-import-operator.ts ./deploy/mac-build/
RUN bun run build

FROM oven/bun:1.3.14
ARG OMP_VERSION=18.8.6
ARG CLAUDE_VERSION=2.1.304
ARG T3_VERSION=0.1.2
ARG CODEX_VERSION=0.156.1
ARG TARGETARCH
ENV DEBIAN_FRONTEND=noninteractive
ENV PATH="/mise/shims:/mise/bin:/opt/partitura/bin:/opt/t3:/opt/codex/bin:/opt/claude/bin:/usr/local/bin:/usr/bin:/bin"
ENV DOCKER_HOST=unix:///run/docker.sock
ENV DOCKER_DATA_ROOT=/workspace/.omp-home/docker
ENV MISE_DATA_DIR=/mise
ENV MISE_CACHE_DIR=/mise/cache
ENV MISE_CONFIG_DIR=/workspace/.omp-home/mise/config
ENV MISE_TRUSTED_CONFIG_PATHS=/workspace
WORKDIR /workspace
RUN apt-get update \
  && apt-get install -y --no-install-recommends build-essential ca-certificates cmake curl git libssl-dev libudev1 openssh-client pkg-config tini iptables iproute2 procps xz-utils fontconfig fonts-liberation fonts-noto-color-emoji libasound2 libatk-bridge2.0-0 libatk1.0-0 libatspi2.0-0 libdbus-1-3 libgbm1 libnspr4 libnss3 libx11-6 libxcb1 libxcomposite1 libxdamage1 libxext6 libxfixes3 libxkbcommon0 libxrandr2 \
  && rm -rf /var/lib/apt/lists/*
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
COPY --from=docker /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker /usr/local/bin/dockerd /usr/local/bin/dockerd
COPY --from=docker /usr/local/bin/containerd-shim-runc-v2 /usr/local/bin/containerd-shim-runc-v2
COPY --from=docker /usr/local/bin/runc /usr/local/bin/runc
COPY --from=docker /usr/local/bin/docker-proxy /usr/local/bin/docker-proxy
COPY --from=docker /usr/local/bin/docker-init /usr/local/bin/docker-init
COPY --from=docker /usr/local/libexec/docker/cli-plugins/docker-compose /usr/local/lib/docker/cli-plugins/docker-compose
COPY --from=mise-tools /usr/local/bin/mise /usr/local/bin/mise
COPY --from=mise-tools /opt/partitura/bin /opt/partitura/bin
COPY --from=mise-tools /opt/partitura/mise/installs /opt/partitura/mise/installs
COPY --from=worker-extensions /opt/omp-extensions /opt/omp-extensions
COPY --from=app-build /app/dist /app/dist
COPY deploy/agent-clis/install-agent-clis.sh /usr/local/bin/install-agent-clis
COPY deploy/agent-clis/claude-cliproxy /usr/local/bin/claude-cliproxy
COPY --chmod=0755 deploy/agent-clis/apply_patch /usr/local/bin/apply_patch
COPY deploy/session-sandbox/worker-init.sh /usr/local/bin/worker-init
COPY deploy/session-sandbox/seed-mise-installs.sh /usr/local/bin/seed-mise-installs
RUN TARGETARCH="${TARGETARCH}" install-agent-clis \
      "claude=${CLAUDE_VERSION}" "codex=${CODEX_VERSION}" "t3=${T3_VERSION}" \
  && case "${TARGETARCH}" in \
       amd64) asset="omp-linux-x64"; checksum="877acdc48384b80fe4c083b1e610433d28922dd9fccde9ea430aaace8765b19b" ;; \
       arm64) asset="omp-linux-arm64"; checksum="a6bf1405877a739965586fcf973136f72078d2e6dc288905fab08588469c13cf" ;; \
       *) echo "Unsupported architecture: ${TARGETARCH}" >&2; exit 1 ;; \
     esac \
  && curl --fail --location --retry 3 \
       "https://github.com/can1357/oh-my-pi/releases/download/v${OMP_VERSION}/${asset}" \
       --output /usr/local/bin/omp \
  && echo "${checksum}  /usr/local/bin/omp" | sha256sum --check --strict \
  && chmod 0755 /usr/local/bin/omp /usr/local/bin/worker-init /usr/local/bin/seed-mise-installs \
  && ln -s /opt/claude/bin/claude /usr/local/bin/claude \
  && ln -s /opt/codex/bin/codex /usr/local/bin/codex \
  && ln -s /opt/t3/t3 /usr/local/bin/t3 \
  && ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
  && ln -s /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
  && chmod 0755 /usr/local/bin/claude-cliproxy \
  && chown -Rh root:root /opt/claude /opt/codex /opt/t3 /opt/omp-extensions \
  && chmod -R go-w /opt/claude /opt/codex /opt/t3 /opt/omp-extensions \
  && chmod -R go-w /opt/partitura/mise/installs \
  && install -d -m 0755 /mise /workspace/.omp-home
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/worker-init"]
