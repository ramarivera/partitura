# Copy to .env in this directory. Set paths, never secret values.
TS_HOSTNAME=partitura
# Optional tailscale up arguments. Tags are assigned by your auth key/policy.
TS_EXTRA_ARGS=
PUBLIC_URL=https://partitura.YOUR-TAILNET.ts.net
# Required in production: comma-separated Linear organization IDs.
LINEAR_ALLOWED_ORGANIZATION_IDS=
# Optional gateway-wide Nix admins and authoritative GitHub owner bindings.
GATEWAY_ADMIN_ORGANIZATION_IDS=
GITHUB_APP_ALLOWED_OWNERS_JSON={}
TS_AUTHKEY_FILE=./secrets/ts_authkey
# For an auth key provided by your secret manager as PARTITURA_TAILSCALE_AUTH_KEY,
# add -f compose.auth-env.yaml instead. Never write that key value into this file.
LINEAR_CLIENT_ID_FILE=./secrets/linear_client_id
LINEAR_CLIENT_SECRET_FILE=./secrets/linear_client_secret
LINEAR_WEBHOOK_SECRET_FILE=./secrets/linear_webhook_secret
TOKEN_ENCRYPTION_KEY_FILE=./secrets/token_encryption_key
