LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_WEBHOOK_SECRET=
TOKEN_ENCRYPTION_KEY=
# Docker/Swarm alternative: set any required KEY via KEY_FILE=/run/secrets/<name>.
PUBLIC_URL=http://localhost:3000
DATABASE_PATH=./data/gateway.sqlite
WORKSPACE_ROOT=./data/workspaces
OMP_CLI_PATH=omp
# Optional existing T3 simulator bridge. Keep its dedicated bearer on the gateway.
# T3_DEVICE_BACKUP_CONFIG_JSON_FILE=/run/secrets/t3_device_backup_config
# JSON: {"baseUrl":"https://existing-t3-server.example","tokenFile":"/run/secrets/t3_device_backup_token","workspaceRoot":"/srv/partitura-device","organizationHosts":{"linear-org-id":["configured-device-host-id"]},"instanceId":"configured-provider","model":"configured-model"}
PORT=3000
LOG_LEVEL=info

# Optional GitHub App authentication. Configure both, or neither.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_PRIVATE_KEY_FILE=/run/secrets/github_app_private_key

NIX_BINARY_PATH=nix
# Set an immutable nixpkgs revision before enabling repository Nix packages.
NIXPKGS_FLAKE_REF=github:NixOS/nixpkgs/ac62194c3917d5f474c1a844b6fd6da2db95077d
NIX_ROOTS_DIR=/app/nix-roots
# Per-GC maximum bytes freed; this is not a store capacity limit.
NIX_GC_MAX_BYTES=10737418240
# Store budget in registered NAR bytes. Active roots and other owners' roots stay rooted.
NIX_STORE_MAX_BYTES=21474836480

LEASE_DURATION_MS=60000
RECONCILER_INTERVAL_MS=1000
RECONCILER_CATCHUP_INTERVAL_MS=300000
RECONCILER_CATCHUP_MIN_AGE_MS=120000
WEBHOOK_REPLAY_WINDOW_MS=60000
REPOSITORY_SUGGESTION_CONFIDENCE_THRESHOLD=0.8

# Run hourly. Terminal workspaces get a one-day grace period.
RETENTION_INTERVAL_MS=3600000
RETENTION_WORKSPACE_TTL_MS=86400000
# Settled delivery payloads only; pending payloads and dedupe identities stay.
RETENTION_DELIVERY_TTL_MS=604800000
# Events and processed inputs of terminal runs only.
RETENTION_EVENT_TTL_MS=604800000
# Projections of terminal runs only; live projector leases stay intact.
RETENTION_PROJECTION_TTL_MS=2592000000
# Remove OAuth states and admin sessions this long after expiration.
RETENTION_AUTH_GRACE_MS=86400000
# Required in production. Unset in development admits all Linear organizations.
LINEAR_ALLOWED_ORGANIZATION_IDS=
# Org IDs granted gateway-wide Nix cache administration. Empty denies everyone.
GATEWAY_ADMIN_ORGANIZATION_IDS=
# Authoritative org -> GitHub owner bindings. Missing binding denies token minting.
GITHUB_APP_ALLOWED_OWNERS_JSON={}
# Explicit development exception for MCP OAuth against loopback HTTP only.
MCP_OAUTH_ALLOW_LOOPBACK_HTTP=false
# Encryption rotation. Keep prior keys until the startup migration has completed.
TOKEN_ENCRYPTION_KEY_ID=1
TOKEN_ENCRYPTION_PREVIOUS_KEYS_JSON={}
# Docker defaults to uid/gid 1001..1064. Use a dedicated, non-root range.
# Leave unset for same-uid native development. Set both to enable isolation.
# WORKER_UID_BASE=1001
# WORKER_UID_COUNT=64
# Deprecated WORKER_UID alone is equivalent to BASE=<value>, COUNT=1.
# An explicit BASE wins over WORKER_UID. Stop the old container before upgrading.
# Firecracker is the default. Sysbox selects the Docker-based isolation option.
# Both require the host broker socket and fail startup without it.
# Set native explicitly for development using local worker processes.
WORKER_SANDBOX_MODE=firecracker
# SESSION_SANDBOX_BROKER_SOCKET=/run/partitura-sandbox/broker.sock
# WORKSPACE_ROOT=/app/workspaces
# Optional encrypted-source map: organization ID -> repository ID -> scoped age identity.
# Materialized per session as mode 0400 via its worker UID. Never use operator/toolbox keys.
# WORKER_REPOSITORY_AGE_KEYS_JSON_FILE=/run/secrets/worker_repository_age_keys_json
# Native build tools are available only when both gateway-only paths are set.
# NATIVE_BUILD_SSH_CONFIG_FILE=/run/secrets/native_build_ssh_config
# NATIVE_BUILD_SCRATCH_ROOT=/app/data/native-build
# Optional independent backup builder. Requires primary configuration and separate paths.
# Each SSH config uses Host partitura-native with its own dedicated host/key pins.
# NATIVE_BUILD_BACKUP_SSH_CONFIG_FILE=/run/secrets/native_backup_ssh_config
# NATIVE_BUILD_BACKUP_SCRATCH_ROOT=/app/data/native-build-backup

# Registry loader settings. Production build starts stay on the legacy callers
# until the separately approved slice 8 assembly/cutover. These settings don't
# enable registry mode yet. Never reuse a legacy scratch root for the new volume.
# Mount the stable registry directory read-only, not registry.json alone. Replace
# registry.json via fsync + sibling rename + parent fsync. Replacing the directory
# requires remount/recreation. Root owns directory 0700 and registry file 0600.
# NATIVE_BUILD_REGISTRY_FILE=/run/partitura-builders/registry.json
# State/cache roots must also be disjoint from legacy scratch and worker roots.
# NATIVE_BUILD_STATE_ROOT=/app/data/native-build-registry
# NATIVE_BUILD_REGISTRY_SCRATCH_ROOT=/app/native-build-registry-scratch
# NATIVE_BUILD_CACHE_ROOT=/run/partitura-native
# NATIVE_BUILD_ALLOWED_HOST_SUFFIX=xalda-procyon.ts.net
# Optional protected file provider. Directory 0700, records 0400, no symlinks.
# NATIVE_BUILD_FILE_SECRET_ROOT=/run/partitura-builder-records
# 1Password reads remain unavailable until the slice 6 helper/qualification.
# No inline token or CLI environment fallback. Token file is separately mounted 0400.
# NATIVE_BUILD_OP_TOKEN_FILE=/run/secrets/native_build_op_token
# NATIVE_BUILD_OP_VAULT_ID=<explicit-vault-id>
# NATIVE_BUILD_OP_DAILY_BUDGET=400
# NATIVE_BUILD_OP_HOURLY_BUDGET=200
# NATIVE_BUILD_REGISTRY_SCRATCH_BYTES_PER_BUILDER=8589934592
# NATIVE_BUILD_REGISTRY_SCRATCH_BYTES_TOTAL=34359738368
# Provision usable scratch capacity at least 2 GiB above the total budget.

RPC_REQUEST_TIMEOUT_MS=30000
GIT_TIMEOUT_MS=120000
NIX_TIMEOUT_MS=600000
MAX_CONCURRENT_WORKERS=4

# Optional T3 Code driver. Repository defaultDriver or a driver:t3 Linear
# issue label selects it for new runs. See docs/agent-drivers.md.
# launch: the gateway starts a private `t3 serve` per session under the
# session's worker uid on a loopback port. Needs CLIPROXYAPI_BASE_URL/_API_KEY.
# remote: one external daemon (T3_BASE_URL + T3_TOKEN[_FILE]) shared by every
# session; refused when WORKER_UID_BASE isolation is active.
# T3_MODE=launch
# T3_PROVIDER_INSTANCE=claude-cliproxy   # launch: claude-cliproxy or codex-cliproxy
# T3_MODEL=claude-opus-5-5
# T3_MODEL_OPTIONS={}
# Launch-only settings (defaults shown):
# T3_CLI_PATH=t3
# T3_PORT_BASE=47100
# T3_PORT_COUNT=64                        # defaults to WORKER_UID_COUNT
# T3_LAUNCH_TIMEOUT_MS=60000
# T3_CODEX_EXECUTABLE=codex
# T3_CLAUDE_EXECUTABLE=claude-cliproxy    # defaults to WORKER_CLAUDE_EXECUTABLE
# T3_CODEX_MODEL=gpt-6-sol
# T3_CODEX_REASONING_EFFORT=high
# T3_TEXT_GENERATION_MODEL=gpt-6-luna
# Remote-only settings:
# T3_BASE_URL=https://t3.example.com
# Only for a trusted private-network endpoint such as http://t3:3773:
# T3_ALLOW_PRIVATE_NETWORK_HTTP=true
# T3_TOKEN_FILE=/run/secrets/t3-gateway-token
# Directory workspaces auto-provision projects. Only ProjectRoot/DriverWorktree
# API consumers need an explicit project id.
# T3_PROJECT_ID=
# auto: Claude auto mode / Codex auto-review in a workspace-write sandbox.
# full-access: Claude bypassPermissions / Codex dangerFullAccess, no prompts.
# Also accepted: approval-required, auto-accept-edits.
# T3_RUNTIME_MODE=auto
# T3_INTERACTION_MODE=default
# T3_ID_NAMESPACE=symphony
